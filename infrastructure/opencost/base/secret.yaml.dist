# Template for the oauth2-proxy secret. Do NOT commit this file with real
# values — copy it, fill it in, seal it with kubeseal, and commit the resulting
# SealedSecret as `sealed.yaml` in the overlay (see ../keycloak/.../local/sealed.yaml
# for the pattern). The secret is per cluster and cannot live in git in plaintext.
#
#   OAUTH2_PROXY_CLIENT_SECRET : the `opencost` client secret generated by
#                                Keycloak (Clients -> opencost -> Credentials).
#   OAUTH2_PROXY_COOKIE_SECRET : a random 32-byte value, e.g.
#                                `openssl rand -base64 32 | head -c 32`
apiVersion: v1
kind: Secret
metadata:
  name: opencost-oauth2-proxy
type: Opaque
stringData:
  OAUTH2_PROXY_CLIENT_SECRET: "REPLACE_WITH_KEYCLOAK_CLIENT_SECRET"
  OAUTH2_PROXY_COOKIE_SECRET: "REPLACE_WITH_RANDOM_32_BYTES"
