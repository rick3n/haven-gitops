{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 30,
  "prConcurrentLimit": 75,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "enabled": false
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^infrastructure/openbao/config/base/(init|auth)/job\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Updates container image versions in .image-versions file",
      "managerFilePatterns": [
        "/\\.image-versions$/"
      ],
      "matchStrings": [
        "(?<depName>.*?):(?<currentValue>.*?)$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
